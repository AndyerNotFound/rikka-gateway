#!/usr/bin/env bash
# rgw - rikka-gateway management CLI (start/stop/status/log/check/smoke/url/edit)
set -uo pipefail

SELF="${BASH_SOURCE[0]}"
while [[ -L "$SELF" ]]; do                       # resolve symlinks so a PATH install can still locate the project dir
  t="$(readlink "$SELF")"; [[ "$t" == /* ]] && SELF="$t" || SELF="$(dirname "$SELF")/$t"
done
DIR="$(cd "$(dirname "$SELF")" && pwd)"          # source dir (read-only use)
RUNTIME="${RGW_HOME:-$HOME/.rgw}"                # runtime dir: logs/pid/pycache
mkdir -p "$RUNTIME"
PID_FILE="$RUNTIME/gateway.pid"
LOG_FILE="$RUNTIME/gateway.log"
export PYTHONPYCACHEPREFIX="$RUNTIME/pycache"    # keep __pycache__ out of the source dir
PY="${PYTHON:-python3}"
cd "$RUNTIME" || exit 1

if [[ -t 1 ]]; then
  G=$'\e[32m'; R=$'\e[31m'; Y=$'\e[33m'; B=$'\e[36m'; D=$'\e[2m'; N=$'\e[0m'
else
  G=''; R=''; Y=''; B=''; D=''; N=''
fi
ok()   { echo "  ${G}✓${N} $*"; }
bad()  { echo "  ${R}✗${N} $*"; }
warn() { echo "  ${Y}!${N} $*"; }
hdr()  { echo "${B}$*${N}"; }

# ---------- config (read from rules.py, fall back to defaults) ----------
cfg() {
  $PY - "$DIR" "$1" <<'PY' 2>/dev/null
import sys
sys.path.insert(0, sys.argv[1])
import rules
print({"lport": rules.LISTEN[1], "uport": rules.UPSTREAM[1],
       "uhost": rules.UPSTREAM[0]}[sys.argv[2]])
PY
}
LPORT="$(cfg lport)"; LPORT="${LPORT:-9000}"
UPORT="$(cfg uport)"; UPORT="${UPORT:-8080}"
UHOST="$(cfg uhost)"; UHOST="${UHOST:-127.0.0.1}"

port_open() { # $1=port
  $PY - "$1" <<'PY'
import socket, sys
s = socket.socket(); s.settimeout(0.4)
sys.exit(0 if s.connect_ex(("127.0.0.1", int(sys.argv[1]))) == 0 else 1)
PY
}

find_pid() {
  if [[ -f "$PID_FILE" ]]; then
    local p; p="$(cat "$PID_FILE" 2>/dev/null)"
    if [[ -n "$p" ]] && kill -0 "$p" 2>/dev/null; then echo "$p"; return; fi
  fi
  local d cmd
  for d in /proc/[0-9]*; do
    [[ -r "$d/cmdline" ]] || continue
    cmd="$(tr '\0' ' ' < "$d/cmdline" 2>/dev/null)"
    if [[ "$cmd" == *"$DIR/gateway.py"* || "$cmd" == *"python"*" gateway.py"* ]]
    then echo "${d#/proc/}"; return; fi
  done
}

wait_port() { # $1=port $2=seconds
  local i n=$(( ${2:-5} * 10 ))
  for ((i = 0; i < n; i++)); do port_open "$1" && return 0; sleep 0.1; done
  return 1
}

# ---------- commands ----------
cmd_start() {
  local pid; pid="$(find_pid)"
  if [[ -n "$pid" ]]; then
    echo "already running (pid $pid) -> http://127.0.0.1:$LPORT/"; return 1
  fi
  if port_open "$LPORT"; then
    echo "${R}port $LPORT already in use by another process${N} (check: ss -ltnp | grep $LPORT)"; return 1
  fi
  if ! port_open "$UPORT"; then
    warn "upstream $UHOST:$UPORT not responding - gateway will still start, but requests will 502"
  fi
  local newpid
  newpid="$( cd "$RUNTIME" && { nohup "$PY" "$DIR/gateway.py" >>"$LOG_FILE" 2>&1 & echo $!; } )"
  echo "$newpid" >"$PID_FILE"
  if wait_port "$LPORT" 5; then
    ok "started (pid $newpid) -> http://127.0.0.1:$LPORT/  -> $UHOST:$UPORT"
  else
    bad "start failed, last log lines:"; tail -n 15 "$LOG_FILE"
    kill "$newpid" 2>/dev/null; rm -f "$PID_FILE"; return 1
  fi
}

cmd_stop() {
  local pid; pid="$(find_pid)"
  if [[ -z "$pid" ]]; then
    rm -f "$PID_FILE"; echo "not running"; return 0
  fi
  kill "$pid" 2>/dev/null
  local i
  for ((i = 0; i < 30; i++)); do kill -0 "$pid" 2>/dev/null || break; sleep 0.1; done
  kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null
  rm -f "$PID_FILE"
  ok "stopped (pid $pid)"
}

cmd_restart() { cmd_stop; sleep 0.3; cmd_start; }

cmd_status() {
  local pid; pid="$(find_pid)"
  hdr "rikka-gateway"
  if [[ -n "$pid" ]]; then
    local up; up="$(ps -o etime= -p "$pid" 2>/dev/null | tr -d ' ')"
    ok "process  running (pid $pid, uptime ${up:-?})"
  else
    bad "process  stopped"
  fi
  if port_open "$LPORT"; then ok "port      $LPORT listening"; else bad "port      $LPORT not listening"; fi
  if port_open "$UPORT"; then ok "upstream  $UHOST:$UPORT online"; else bad "upstream  $UHOST:$UPORT offline"; fi
  local assets="$DIR/assets"
  local n; n=$(ls "$assets" 2>/dev/null | wc -l)
  echo "  ${D}runtime  $RUNTIME (gateway.log, gateway.pid, pycache)${N}"
  echo "  ${D}rules    rules.py ($(stat -c %y "$DIR/rules.py" 2>/dev/null | cut -d. -f1))${N}"
  echo "  ${D}assets   $n file(s) in assets/${N}"
  if [[ -f "$LOG_FILE" ]]; then
    echo "  ${D}log      $(wc -l <"$LOG_FILE") lines, last request:${N}"
    grep -E '^\[gw\] [0-9]{3} ' "$LOG_FILE" | tail -n 1 | sed 's/^/         /'
  fi
  echo "  ${D}url      http://$(lan_ip):$LPORT/${N}"
}

lan_ip() {
  $PY - <<'PY' 2>/dev/null || echo 127.0.0.1
import socket
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
try:
    s.connect(("8.8.8.8", 80)); print(s.getsockname()[0])
except OSError:
    print("127.0.0.1")
PY
}

cmd_log() {
  [[ -f "$LOG_FILE" ]] || { echo "no log yet"; return 1; }
  if [[ "${1:-}" == "-f" ]]; then tail -f "$LOG_FILE"
  else tail -n "${1:-40}" "$LOG_FILE"; fi
}

cmd_check() {
  hdr "rules/assets self-check"
  $PY - "$DIR" <<'PY'
import sys, os, socket
DIR = sys.argv[1]; sys.path.insert(0, DIR)
import rules
okall = True
def bad(m):
    global okall; okall = False; print("  \033[31m✗\033[0m " + m) if os.isatty(1) else print("  x " + m)
def good(m):
    print("  \033[32m✓\033[0m " + m) if os.isatty(1) else print("  . " + m)

err = rules.validate()
(good if not err else bad)("rules.validate() " + (err or "OK"))

for p, rel in rules.STATIC_OVERRIDES.items():
    fp = os.path.join(DIR, rel)
    (good if os.path.isfile(fp) else bad)(f"static override {p} -> {rel}" + (f" ({os.path.getsize(fp)}B)" if os.path.isfile(fp) else " file missing"))

base = f"http://{rules.UPSTREAM[0]}:{rules.UPSTREAM[1]}"
def fetch(path):
    import urllib.request
    with urllib.request.urlopen(base + path, timeout=20) as r:
        return r.status, r.read()

if not rules.JS_REWRITES:
    good("no JS asset rewrites configured")
for path, pairs in rules.JS_REWRITES.items():
    try:
        st, body = fetch(path)
    except Exception as e:
        bad(f"JS asset {path} fetch failed: {e}"); continue
    if st != 200:
        bad(f"JS asset {path} HTTP {st}"); continue
    miss = [old for old, _ in pairs if old.encode() not in body]
    if miss:
        bad(f"JS asset {path}: {len(miss)}/{len(pairs)} anchors missed (upstream update changed hash/wording?)")
        for m in miss[:3]:
            print(f"      - {m[:70]}")
    else:
        good(f"JS asset {path}: all {len(pairs)} anchors matched")

for path in rules.API_REWRITES:
    try:
        st, _ = fetch(path)
        (good if st == 200 else bad)(f"API rewrite {path} (HTTP {st})")
    except Exception as e:
        bad(f"API rewrite {path} unreachable: {e}")

sys.exit(0 if okall else 1)
PY
}

cmd_smoke() {
  hdr "end-to-end smoke (through gateway :$LPORT)"
  port_open "$LPORT" || { bad "gateway not running (rgw start)"; return 1; }
  local fail=0 gw up
  gw="$(curl -s -m 10 "http://127.0.0.1:$LPORT/")"
  up="$(curl -s -m 10 "http://$UHOST:$UPORT/")"
  [[ -n "$gw" ]] || { bad "gateway homepage no response"; return 1; }
  if [[ "$gw" != "$up" ]]; then ok "homepage rewritten (differs from upstream)"
  else bad "homepage identical to upstream - HTML injection not active"; fail=1; fi

  local p code
  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    code="$(curl -s -o /dev/null -w '%{http_code}' -m 5 "http://127.0.0.1:$LPORT$p")"
    if [[ "$code" == 200 ]]; then ok "static override $p (200)"; else bad "static override $p (HTTP $code)"; fail=1; fi
  done < <($PY -c "import sys;sys.path.insert(0,'$DIR');import rules;print('\n'.join(rules.STATIC_OVERRIDES))" 2>/dev/null)

  while IFS= read -r p; do
    [[ -z "$p" ]] && continue
    if cmp -s <(curl -s -m 30 "http://127.0.0.1:$LPORT$p") <(curl -s -m 30 "http://$UHOST:$UPORT$p"); then
      bad "JS rewrite inactive $p (identical to upstream)"; fail=1
    else
      ok "JS rewrite $p"
    fi
  done < <($PY -c "import sys;sys.path.insert(0,'$DIR');import rules;print('\n'.join(rules.JS_REWRITES))" 2>/dev/null)

  [[ $fail -eq 0 ]] && { echo "  ${G}all checks passed${N}"; return 0; }
  echo "  ${R}some checks failed${N}"; return 1
}

cmd_banner() { echo "http://$(lan_ip):$LPORT/"; }

cmd_edit() { "${EDITOR:-vi}" "$DIR/rules.py"; }

cmd_help() {
  cat <<H
${B}rgw${N} — rikka-gateway
  source  $DIR
  runtime $RUNTIME  (gateway.log / gateway.pid / pycache)
  upstream $UHOST:$UPORT -> listening on :$LPORT

  rgw start        start in background (nohup, log to gateway.log)
  rgw stop         stop
  rgw restart      restart
  rgw status       process/port/upstream/log overview
  rgw log [N|-f]   show log (default 40 lines, -f to follow)
  rgw check        rule self-check + JS anchors/static overrides/API (run after upstream updates)
  rgw smoke        end-to-end smoke (homepage/static overrides/JS rewrites via gateway)
  rgw url          print LAN access URL
  rgw edit         edit rules.py (hot reload, no restart needed)
  rgw help         this help
H
}

case "${1:-help}" in
  start)   cmd_start ;;
  stop)    cmd_stop ;;
  restart) cmd_restart ;;
  status)  cmd_status ;;
  log)     shift; cmd_log "$@" ;;
  check)   cmd_check ;;
  smoke)   cmd_smoke ;;
  url)     cmd_banner ;;
  edit)    cmd_edit ;;
  help|-h|--help) cmd_help ;;
  *) echo "unknown command: $1"; echo; cmd_help; exit 1 ;;
esac
